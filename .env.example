# GhostSlate AI — Environment Configuration Example

# Server
PORT=8080
LOG_LEVEL=info
NODE_ENV=development

# Google Cloud / Vertex AI
GCP_PROJECT_ID=
GCP_REGION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# ClickHouse Cloud
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# MCP ClickHouse Server (Docker / Container endpoint)
MCP_CLICKHOUSE_ENDPOINT=http://localhost:8000
