# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- ClickHouse ---------------------------------------------------------------
# For ClickHouse Cloud, set host, port=8443, and secure=true.
# For local docker-compose dev, leave host empty (resolves to container), port=8123, secure=false.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_SECURE=false
CLICKHOUSE_VERIFY=false
CLICKHOUSE_DATABASE=ghostslate

# Admin password for ClickHouse server initialization and local maintenance.
# Used exclusively by the clickhouse service container and init scripts.
# Default provided for local docker-compose development; must be replaced outside local dev.
CLICKHOUSE_ADMIN_PASSWORD=ghostslate_admin_local_dev

# Read-only user created for the agent. Not the admin account: the agent's
# data path is untrusted input reaching a SQL engine, and the only durable
# defence is a role that cannot write.
CLICKHOUSE_USER=ghostslate_agent
# Password for the read-only agent user (consumed by mcp-clickhouse and app).
# Default provided for local docker-compose development; must be replaced outside local dev.
CLICKHOUSE_AGENT_PASSWORD=ghostslate_agent_local_dev

# --- MCP server -------------------------------------------------------------
# SSE transport: the agent reaches this over the network, so stdio is not an option.
CLICKHOUSE_MCP_SERVER_TRANSPORT=sse
CLICKHOUSE_MCP_BIND_HOST=0.0.0.0
CLICKHOUSE_MCP_BIND_PORT=8000
CLICKHOUSE_MCP_AUTH_TOKEN=
CLICKHOUSE_MCP_AUTH_DISABLED=true
# URL consumed by the GhostSlate server's MCP client. For local compose this is
# http://mcp-clickhouse:8000; production should use the deployed official SSE server.
MCP_SERVER_URL=http://mcp-clickhouse:8000

# --- Google Cloud / Vertex AI -----------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# --- App runtime -------------------------------------------------------------
PORT=8080
LOG_LEVEL=info
NODE_ENV=development
